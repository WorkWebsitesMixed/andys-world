---
/**
 * Front + side orthographic views of the W2 worked-example shelf bracket
 * (L-bracket, two mounting holes, angled rib), with a line-type legend.
 * Theme-aware inline SVG.
 */
const caption =
  'Front and side views of an L-shaped shelf bracket. Outline is thick continuous, hidden detail is thin dashed, centre lines are dash-dot through the holes, and the dimension line carries arrowheads and never crosses an outline.';
---

<figure class="diagram">
  <svg viewBox="0 0 560 260" role="img" aria-labelledby="or-t or-d" class="dg">
    <title id="or-t">Orthographic front and side views of an L-bracket</title>
    <desc id="or-d">{caption}</desc>

    <!-- FRONT VIEW -->
    <g transform="translate(20,10)">
      <text x="90" y="14" text-anchor="middle" class="sub">Front view</text>

      <!-- L-shaped outline: vertical arm + horizontal foot + angled rib -->
      <path d="M50,30 L72,30 L72,120 L150,120 L150,142 L50,142 Z" class="outline" />
      <path d="M72,66 L118,120" class="outline" />

      <!-- mounting holes -->
      <circle cx="61" cy="50" r="7" class="outline" />
      <circle cx="132" cy="131" r="7" class="outline" />

      <!-- centre lines through holes -->
      <line x1="61" y1="36" x2="61" y2="64" class="centre" />
      <line x1="47" y1="50" x2="75" y2="50" class="centre" />
      <line x1="132" y1="117" x2="132" y2="145" class="centre" />
      <line x1="118" y1="131" x2="146" y2="131" class="centre" />

      <!-- hidden edge: back face of the arm, behind the front face -->
      <line x1="58" y1="30" x2="58" y2="120" class="hidden" />

      <!-- dimension: arm length along the foot -->
      <line x1="50" y1="160" x2="150" y2="160" class="dim" marker-start="url(#arrow)" marker-end="url(#arrow)" />
      <line x1="50" y1="142" x2="50" y2="164" class="dim-ext" />
      <line x1="150" y1="142" x2="150" y2="164" class="dim-ext" />
      <text x="100" y="176" text-anchor="middle" class="sub">50 mm</text>
    </g>

    <!-- SIDE VIEW -->
    <g transform="translate(280,10)">
      <text x="60" y="14" text-anchor="middle" class="sub">Side view</text>
      <rect x="30" y="30" width="18" height="112" class="outline" />
      <rect x="48" y="112" width="70" height="18" class="outline" />

      <line x1="15" y1="30" x2="15" y2="142" class="dim" marker-start="url(#arrow)" marker-end="url(#arrow)" />
      <line x1="10" y1="30" x2="30" y2="30" class="dim-ext" />
      <line x1="10" y1="142" x2="30" y2="142" class="dim-ext" />
      <text x="8" y="90" text-anchor="middle" class="sub" transform="rotate(-90 8 90)">18 mm</text>
    </g>

    <defs>
      <marker id="arrow" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M0,0 L10,5 L0,10 z" class="fill-dim" />
      </marker>
    </defs>

    <!-- LINE-TYPE LEGEND -->
    <g transform="translate(20,200)">
      <text x="0" y="0" class="sub">Line types:</text>

      <line x1="0" y1="20" x2="40" y2="20" class="outline" />
      <text x="46" y="24" class="lbl">Outline</text>

      <line x1="140" y1="20" x2="180" y2="20" class="hidden" />
      <text x="186" y="24" class="lbl">Hidden</text>

      <line x1="270" y1="20" x2="310" y2="20" class="centre" />
      <text x="316" y="24" class="lbl">Centre</text>

      <line x1="400" y1="20" x2="440" y2="20" class="dim" marker-start="url(#arrow)" marker-end="url(#arrow)" />
      <text x="446" y="24" class="lbl">Dimension</text>
    </g>
  </svg>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .diagram { margin-block: 1.75rem; }
  .dg { width: 100%; height: auto; max-width: 560px; display: block; margin-inline: auto; }
  figcaption {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-faint);
    text-align: center;
    max-width: 42rem;
    margin-inline: auto;
  }
  .outline { fill: var(--bg-3); stroke: var(--text); stroke-width: 2.5; stroke-linejoin: round; }
  .hidden { fill: none; stroke: var(--text-dim); stroke-width: 1.5; stroke-dasharray: 4 3; }
  .centre { stroke: var(--accent); stroke-width: 1.3; stroke-dasharray: 8 3 2 3; }
  .dim { fill: none; stroke: var(--text-faint); stroke-width: 1.3; }
  .dim-ext { stroke: var(--text-faint); stroke-width: 1; }
  .fill-dim { fill: var(--text-faint); }
  .lbl { fill: var(--text); font-family: var(--font-body); font-size: 12px; }
  .sub { fill: var(--text-faint); font-family: var(--font-body); font-size: 11px; }
</style>
