---
/**
 * Five structural joints: halving, bridle, mortise & tenon, dowel, KD fitting.
 * Theme-aware inline SVG.
 */
const caption =
  'Five ways to join structural members: halving and bridle notch the members together, mortise and tenon uses a peg-in-hole fit, dowels align with round pegs, and KD fittings use a cam and bolt so the joint can be taken apart without tools.';
---

<figure class="diagram">
  <svg viewBox="0 0 620 190" role="img" aria-labelledby="sj-t sj-d" class="dg">
    <title id="sj-t">Five structural joints</title>
    <desc id="sj-d">{caption}</desc>

    <!-- Halving joint: two members notched halfway, overlapping -->
    <g>
      <rect x="20" y="70" width="80" height="16" class="member" />
      <rect x="52" y="46" width="16" height="64" class="member" />
      <text x="60" y="150" text-anchor="middle" class="lbl">Halving</text>
    </g>

    <!-- Bridle joint: slot + tongue interlock -->
    <g>
      <path d="M140,60 h20 v14 h20 v14 h-20 v14 h-20 z" class="member" />
      <rect x="180" y="74" width="40" height="14" class="member" />
      <text x="180" y="150" text-anchor="middle" class="lbl">Bridle</text>
    </g>

    <!-- Mortise & tenon: peg into hole -->
    <g>
      <rect x="260" y="50" width="18" height="60" class="member" />
      <rect x="266" y="60" width="6" height="20" class="tenon" />
      <rect x="300" y="55" width="30" height="50" class="member" />
      <rect x="310" y="60" width="6" height="20" class="hole" />
      <text x="300" y="150" text-anchor="middle" class="lbl">Mortise &amp; tenon</text>
    </g>

    <!-- Dowel joint: round pegs align two panels -->
    <g>
      <rect x="370" y="55" width="18" height="55" class="member" />
      <rect x="410" y="55" width="18" height="55" class="member" />
      <circle cx="388" cy="70" r="4" class="dowel" />
      <circle cx="410" cy="70" r="4" class="dowel" />
      <line x1="392" y1="70" x2="406" y2="70" class="dowelpin" />
      <circle cx="388" cy="95" r="4" class="dowel" />
      <circle cx="410" cy="95" r="4" class="dowel" />
      <line x1="392" y1="95" x2="406" y2="95" class="dowelpin" />
      <text x="399" y="150" text-anchor="middle" class="lbl">Dowel</text>
    </g>

    <!-- KD fitting: cam lock and bolt -->
    <g>
      <rect x="460" y="55" width="60" height="18" class="member" />
      <rect x="460" y="90" width="18" height="45" class="member" />
      <circle cx="490" cy="64" r="10" class="cam" />
      <line x1="490" y1="64" x2="497" y2="59" class="camline" />
      <line x1="469" y1="82" x2="469" y2="99" class="bolt" />
      <text x="490" y="150" text-anchor="middle" class="lbl">KD fitting</text>
    </g>
  </svg>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .diagram { margin-block: 1.75rem; }
  .dg { width: 100%; height: auto; max-width: 620px; display: block; margin-inline: auto; }
  figcaption {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-faint);
    text-align: center;
    max-width: 42rem;
    margin-inline: auto;
  }
  .member { fill: var(--bg-3); stroke: var(--text); stroke-width: 2; stroke-linejoin: round; }
  .tenon { fill: var(--accent-wash); stroke: var(--accent); stroke-width: 1.5; }
  .hole { fill: var(--bg); stroke: var(--accent); stroke-width: 1.5; stroke-dasharray: 2 2; }
  .dowel { fill: var(--bg); stroke: var(--text); stroke-width: 1.5; }
  .dowelpin { stroke: var(--accent); stroke-width: 2.5; }
  .cam { fill: var(--bg); stroke: var(--text); stroke-width: 2; }
  .camline { stroke: var(--accent); stroke-width: 2; }
  .bolt { stroke: var(--text); stroke-width: 3; }
  .lbl { fill: var(--text-dim); font-family: var(--font-body); font-size: 12px; }
</style>
