---
/**
 * A ductile metal's stress-strain curve: a straight elastic region (slope =
 * Young's modulus, stiffness) up to the yield point, then a flatter,
 * curved plastic region up to ultimate tensile strength, then fracture.
 * Qualitative — axes are unlabelled with numbers on purpose, this is a
 * "taste beyond IGCSE" concept diagram, not a calculation.
 */
const caption =
  "A ductile metal under increasing tensile load. Up to the yield point, stress and strain rise together in a straight line — the elastic region, where the material springs back if the load is removed, and the line's steepness is its stiffness (Young's modulus). Past yield, the material deforms permanently (the plastic region) up to its ultimate tensile strength, then fractures.";
---

<figure class="diagram">
  <svg viewBox="0 0 400 260" role="img" aria-labelledby="ss-t ss-d" class="dg">
    <title id="ss-t">A ductile metal's stress-strain curve</title>
    <desc id="ss-d">{caption}</desc>
    <defs>
      <marker id="ss-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M0,0 L10,5 L0,10 z" class="fill-axis" />
      </marker>
    </defs>

    <!-- Axes -->
    <line x1="55" y1="220" x2="55" y2="24" class="axis" marker-end="url(#ss-arrow)" />
    <line x1="55" y1="220" x2="365" y2="220" class="axis" marker-end="url(#ss-arrow)" />
    <text x="30" y="30" text-anchor="middle" class="axis-lbl">Stress</text>
    <text x="345" y="238" text-anchor="middle" class="axis-lbl">Strain</text>

    <!-- Elastic region: straight line, origin to yield -->
    <line x1="55" y1="220" x2="130" y2="108" class="curve-elastic" />

    <!-- Plastic region: curved, yield to UTS to fracture -->
    <path d="M 130,108 C 175,70 210,58 240,56 C 265,55 285,64 296,88" class="curve-plastic" />

    <!-- Yield point marker -->
    <circle cx="130" cy="108" r="4" class="pt" />
    <line x1="130" y1="108" x2="130" y2="220" class="guide" />
    <text x="130" y="234" text-anchor="middle" class="dim">Yield strain</text>
    <text x="140" y="100" text-anchor="start" class="lbl">Yield point</text>

    <!-- UTS point marker -->
    <circle cx="240" cy="56" r="4" class="pt-accent2" />
    <text x="240" y="42" text-anchor="middle" class="lbl-accent2">Ultimate tensile strength</text>

    <!-- Fracture point marker -->
    <circle cx="296" cy="88" r="4" class="pt-warn" />
    <text x="304" y="92" text-anchor="start" class="lbl-warn">Fracture</text>

    <!-- Region labels -->
    <text x="70" y="200" text-anchor="start" class="region">Elastic region</text>
    <text x="70" y="212" text-anchor="start" class="region-sub">slope = stiffness (Young's modulus)</text>
    <text x="175" y="195" text-anchor="start" class="region">Plastic region — permanent deformation</text>
  </svg>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .diagram { margin-block: 1.75rem; }
  .dg { width: 100%; height: auto; max-width: 440px; display: block; margin-inline: auto; }
  figcaption {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-faint);
    text-align: center;
    max-width: 38rem;
    margin-inline: auto;
  }
  .axis { stroke: var(--text-faint); stroke-width: 1.5; fill: none; }
  .fill-axis { fill: var(--text-faint); }
  .axis-lbl { fill: var(--text-faint); font-size: 12px; font-family: var(--font-body); }
  .curve-elastic { stroke: var(--accent); stroke-width: 2.5; fill: none; }
  .curve-plastic { stroke: var(--accent-2); stroke-width: 2.5; fill: none; }
  .guide { stroke: var(--text-faint); stroke-width: 1; stroke-dasharray: 3 3; }
  .pt { fill: var(--accent); }
  .pt-accent2 { fill: var(--accent-2); }
  .pt-warn { fill: var(--warn, #f59e0b); }
  text { font-family: var(--font-body); font-size: 12px; }
  .dim { fill: var(--text-faint); font-size: 11px; }
  .lbl { fill: var(--accent); font-size: 12px; }
  .lbl-accent2 { fill: var(--accent-2); font-size: 12px; }
  .lbl-warn { fill: var(--warn, #f59e0b); font-size: 12px; }
  .region { fill: var(--text-dim); font-size: 12px; font-weight: 600; }
  .region-sub { fill: var(--text-faint); font-size: 11px; }
</style>
