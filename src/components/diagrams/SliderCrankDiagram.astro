---
/**
 * The slider-crank mechanism: crank arm, crank pin, connecting rod, slider.
 * Two crank positions shown (solid + faded) so the stroke is visible.
 * Theme-aware inline SVG.
 */
const caption =
  'The crank arm rotates about the fixed pivot. The crank pin traces a circle. The connecting rod links the crank pin to the slider, converting the rotary motion of the crank into the reciprocating motion of the slider. Stroke = 2 × crank-arm length.';
---

<figure class="diagram">
  <svg viewBox="0 0 460 220" role="img" aria-labelledby="sc-t sc-d" class="dg">
    <title id="sc-t">The slider-crank mechanism</title>
    <desc id="sc-d">{caption}</desc>
    <defs>
      <marker id="sc-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M0,0 L10,5 L0,10 z" class="fill-accent" />
      </marker>
    </defs>

    <!-- Slider guide -->
    <line x1="300" y1="110" x2="420" y2="110" class="guide" />
    <rect x="380" y="80" width="8" height="60" class="wall" />

    <!-- Crank circle (path the crank pin traces) -->
    <circle cx="90" cy="110" r="50" class="guide-arc" />

    <!-- Faded second position: crank pointing up-left -->
    <g class="faded">
      <line x1="90" y1="110" x2="55" y2="70" class="member" />
      <circle cx="55" cy="70" r="5" class="pin" />
      <line x1="55" y1="70" x2="330" y2="110" class="member" />
    </g>

    <!-- Main position: crank pointing right (extended stroke) -->
    <line x1="90" y1="110" x2="140" y2="110" class="member accent" />
    <circle cx="90" cy="110" r="4" class="pivot" />
    <circle cx="140" cy="110" r="5" class="pin accent-fill" />
    <line x1="140" y1="110" x2="340" y2="110" class="member" />
    <rect x="330" y="98" width="30" height="24" class="slider" />

    <!-- Stroke indicator -->
    <line x1="90" y1="180" x2="190" y2="180" class="arrow" marker-start="url(#sc-arrow)" marker-end="url(#sc-arrow)" />
    <text x="140" y="196" text-anchor="middle" class="dim">stroke = 2 × crank-arm length</text>

    <!-- Labels -->
    <text x="90" y="130" text-anchor="middle" class="lbl">fixed pivot</text>
    <text x="115" y="95" text-anchor="middle" class="lbl">crank arm</text>
    <text x="140" y="90" text-anchor="middle" class="lbl">crank pin</text>
    <text x="240" y="95" text-anchor="middle" class="lbl">connecting rod</text>
    <text x="345" y="145" text-anchor="middle" class="lbl">slider</text>
  </svg>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .diagram { margin-block: 1.75rem; }
  .dg { width: 100%; height: auto; max-width: 460px; display: block; margin-inline: auto; }
  figcaption {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-faint);
    text-align: center;
    max-width: 40rem;
    margin-inline: auto;
  }
  .member { fill: none; stroke: var(--text); stroke-width: 3; stroke-linecap: round; }
  .accent { stroke: var(--accent); }
  .faded { opacity: 0.35; }
  .guide { stroke: var(--text-faint); stroke-width: 1.5; stroke-dasharray: 4 4; }
  .guide-arc { fill: none; stroke: var(--text-faint); stroke-width: 1.2; stroke-dasharray: 3 4; }
  .wall {
    fill: var(--bg-3);
    stroke: var(--text);
    stroke-width: 1.5;
  }
  .pivot { fill: var(--text); }
  .pin { fill: var(--bg); stroke: var(--text); stroke-width: 2; }
  .accent-fill { fill: var(--accent); stroke: var(--accent); }
  .slider { fill: var(--bg-3); stroke: var(--text); stroke-width: 2; }
  .arrow { stroke: var(--accent); stroke-width: 2; fill: none; }
  .fill-accent { fill: var(--accent); }
  .lbl { fill: var(--text-dim); font-family: var(--font-body); font-size: 11px; }
  .dim { fill: var(--text-faint); font-size: 11px; }
</style>
