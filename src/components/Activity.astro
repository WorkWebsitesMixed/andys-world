---
import Section from './Section.astro';

interface Props {
  title?: string;
  /** e.g. "25 min". */
  time?: string;
  /** e.g. "Pairs", "Individual", "Groups of 3". */
  grouping?: string;
  /** Optional materials list. */
  materials?: string[];
  /**
   * "Today's plan" mode (pilot). The block is meant to sit near the top of the
   * lesson, so students see the whole run-sheet before the theory. The section
   * heading becomes "Today's plan" and the lesson-specific title is shown as a
   * bold line inside it. Without `plan` the block renders exactly as before.
   */
  plan?: boolean;
}

const { title = 'Activity', time, grouping, materials, plan = false } = Astro.props;
---

<Section
  title={plan ? "Today's plan" : title}
  navLabel={plan ? "Today's plan" : 'Activity'}
  icon={plan ? '📋' : '🛠️'}
  id="activity"
>
  {plan && <p class="plan-title">{title}</p>}
  {(time || grouping) && (
    <div class="meta">
      {time && <span class="chip">⏱ {time}</span>}
      {grouping && <span class="chip">👥 {grouping}</span>}
    </div>
  )}
  <div class="activity-body">
    <slot />
  </div>
  {materials && materials.length > 0 && (
    <div class="materials">
      <span class="eyebrow">You'll need</span>
      <ul>
        {materials.map((m) => <li>{m}</li>)}
      </ul>
    </div>
  )}
</Section>

<style>
  .plan-title {
    margin: 0 0 0.75rem;
    font-weight: 600;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .chip {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-dim);
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: 0.2rem 0.7rem;
  }
  .materials {
    margin-top: 1rem;
    padding: 0.9rem 1.1rem;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--bg-1);
  }
  .materials ul { margin: 0.4rem 0 0; }
</style>
