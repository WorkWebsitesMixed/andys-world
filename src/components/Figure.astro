---
/**
 * A captioned image with required alt text (UDL). Use for photographs/diagrams
 * hosted as image files. For inline SVG concept diagrams, use the components in
 * components/diagrams/ instead.
 *
 * `src` is resolved through url(), so pass a path relative to public/, e.g.
 * src="images/tools/pillar-drill.jpg" — no need to prefix the base path.
 */
import { url } from '../lib/url';

interface Props {
  src: string;
  alt: string;
  caption?: string;
  /** Optional max display width, e.g. "32rem". */
  width?: string;
  /** Attribution line for an openly-licensed photo, e.g. "Luke Milburn, CC BY 2.0, via Wikimedia Commons". */
  credit?: string;
  /** Link the credit line to the image's source page. */
  creditHref?: string;
}

const { src, alt, caption, width, credit, creditHref } = Astro.props;
const resolvedSrc = /^(https?:)?\/\//.test(src) ? src : url(src);
---

<figure class="figure" style={width ? `--fig-w:${width}` : undefined}>
  <img src={resolvedSrc} alt={alt} loading="lazy" decoding="async" />
  {caption && <figcaption>{caption}</figcaption>}
  {credit && (
    <p class="credit">
      {creditHref ? <a href={creditHref} target="_blank" rel="noopener noreferrer">{credit}</a> : credit}
    </p>
  )}
</figure>

<style>
  .figure { margin-block: 1.75rem; }
  .figure img {
    display: block;
    margin-inline: auto;
    max-width: min(100%, var(--fig-w, 100%));
    border: 1px solid var(--line);
  }
  figcaption {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-faint);
    text-align: center;
    max-width: 38rem;
    margin-inline: auto;
  }
  .credit {
    margin-top: 0.2rem;
    font-size: 0.72rem;
    color: var(--text-faint);
    text-align: center;
  }
  .credit a {
    color: inherit;
    border-bottom: 1px dashed currentColor;
  }
</style>
