---
/**
 * A link out to a pre-filled Google Images search — a supplement to a
 * hand-drawn diagram. Deliberate choice, made with the tradeoff known:
 * unlike a Wikimedia Commons search, results aren't licence-filtered and
 * aren't moderated by us — Andy weighed that and chose this anyway after
 * Commons' own search (Special:MediaSearch) returned empty for several
 * multi-word queries here.
 */
interface Props {
  /** The search term, e.g. "roof truss bridge". Kept short and concrete. */
  term: string;
}

const { term } = Astro.props;
const href = `https://www.google.com/search?q=${encodeURIComponent(term)}&tbm=isch`;
---

<p class="more-images">
  <span class="ic" aria-hidden="true">🖼️</span>
  <a href={href} target="_blank" rel="noopener noreferrer">
    See more real photos of {term} on Google Images
  </a>
</p>

<style>
  .more-images {
    margin-block: 0.25rem 1.75rem;
    font-size: 0.88rem;
    color: var(--text-dim);
  }
  .ic {
    margin-right: 0.3rem;
  }
  .more-images a {
    color: var(--accent);
    border-bottom: 1px dashed currentColor;
  }
</style>
