---
import type { GetStaticPaths } from 'astro';
import SkillsLessonLayout from '../../../../layouts/SkillsLessonLayout.astro';
import { getSkillsTerm } from '../../../../lib/skills';
import { routes } from '../../../../lib/url';
import { getCollection } from 'astro:content';

export const getStaticPaths = (async () => {
  const all = await getCollection('skills', (s) => !s.data.draft);
  return all.map((s) => ({
    params: { term: s.data.term, code: s.data.code.toLowerCase() },
  }));
}) satisfies GetStaticPaths;

const { term, code } = Astro.params;
const info = getSkillsTerm(term!)!;

const termCards = (await getCollection('skills', (s) => s.data.term === term && !s.data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const idx = termCards.findIndex((c) => c.data.code.toLowerCase() === code);
const card = termCards[idx];

const prev = idx > 0 ? termCards[idx - 1] : undefined;
const next = idx >= 0 && idx < termCards.length - 1 ? termCards[idx + 1] : undefined;
---

<SkillsLessonLayout
  card={card}
  termInfo={info}
  prev={prev && { href: routes.skillsSession(term!, prev.data.code), label: `${prev.data.code} · ${prev.data.title}` }}
  next={next && { href: routes.skillsSession(term!, next.data.code), label: `${next.data.code} · ${next.data.title}` }}
/>
