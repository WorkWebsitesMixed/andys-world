---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import { getSkillsTerm } from '../../../../lib/skills';
import { routes } from '../../../../lib/url';
import { getCollection, render } from 'astro:content';

export const getStaticPaths = (async () => {
  const all = await getCollection('skills', (s) => !s.data.draft);
  return all.map((s) => ({
    params: { term: s.data.term, code: s.data.code.toLowerCase() },
  }));
}) satisfies GetStaticPaths;

const { term, code } = Astro.params;
const info = getSkillsTerm(term!)!;

const termCards = (await getCollection('skills', (s) => s.data.term === term && !s.data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const idx = termCards.findIndex((c) => c.data.code.toLowerCase() === code);
const card = termCards[idx];

const prev = idx > 0 ? termCards[idx - 1] : undefined;
const next = idx >= 0 && idx < termCards.length - 1 ? termCards[idx + 1] : undefined;

const { Content } = await render(card);
---

<BaseLayout title={`SKILLS ${card.data.code} — ${card.data.title}`}>
  <article class="container session">
    <Breadcrumbs
      items={[
        { label: 'Skills', href: routes.skills() },
        { label: info.label, href: routes.skillsTerm(term!) },
        { label: card.data.code },
      ]}
    />

    <header class="session-head">
      <span class="skills-tag">
        {card.data.code} · 45 min · maps to
        {' '}
        <a href={routes.week(11, info.targetGradeTerm, card.data.mapsToWeek)}>
          Grade 11 Week {card.data.mapsToWeek}
        </a>
      </span>
      <h1>{card.data.title}</h1>
      <p class="hook">{card.data.hook}</p>
      {card.data.badges.length > 0 && (
        <div class="badges">
          {card.data.badges.map((b) => <span class="badge">{b}</span>)}
        </div>
      )}
    </header>

    <div class="goals-block">
      <h2 class="goals-heading">Goals</h2>
      <dl class="goals-list">
        <dt>Mastery</dt>
        <dd>{card.data.masteryGoal}</dd>
        <dt>Tutor / TA</dt>
        <dd>{card.data.tutorGoal}</dd>
      </dl>
    </div>

    <div class="prose">
      <Content />
    </div>

    <nav class="prev-next" aria-label="Card navigation">
      {prev ? (
        <a class="prev-next-link" href={routes.skillsSession(term!, prev.data.code)}>
          <span class="nav-dir">← Previous</span>
          <span class="nav-title">{prev.data.code} · {prev.data.title}</span>
        </a>
      ) : <span />}
      {next && (
        <a class="prev-next-link next" href={routes.skillsSession(term!, next.data.code)}>
          <span class="nav-dir">Next →</span>
          <span class="nav-title">{next.data.code} · {next.data.title}</span>
        </a>
      )}
    </nav>
  </article>
</BaseLayout>

<style>
  .session {
    padding-block: 1.5rem 4rem;
    max-width: var(--readw);
  }

  .session-head {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin-block: 1rem 1.5rem;
  }

  .skills-tag {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--accent-2);
  }
  .skills-tag a { color: var(--accent-2); text-decoration: underline; }
  .skills-tag a:hover { color: var(--text); }

  .session-head h1 {
    margin: 0.3rem 0 0.2rem;
    font-size: clamp(1.6rem, 4vw, 2.2rem);
  }

  .hook {
    font-size: 1.05rem;
    color: var(--text-dim);
    margin: 0;
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.4rem;
  }
  .badge {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--accent);
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: 0.2rem 0.7rem;
  }

  .goals-block {
    background: var(--bg-1);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.1rem 1.4rem;
    margin-block: 1.5rem;
  }

  .goals-heading {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin: 0 0 0.75rem;
  }

  .goals-list {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .goals-list dt {
    font-size: 0.78rem;
    font-family: var(--font-mono);
    color: var(--accent-2);
    margin-top: 0.5rem;
  }
  .goals-list dt:first-child { margin-top: 0; }
  .goals-list dd {
    margin: 0;
    font-size: 0.93rem;
    color: var(--text-dim);
    line-height: 1.5;
  }

  .prose {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-dim);
    margin-block: 1.5rem;
  }
  .prose :global(h2) {
    font-size: 1.1rem;
    color: var(--text);
    margin: 1.6rem 0 0.5rem;
  }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(p) { margin: 0 0 1rem; }
  .prose :global(strong) { color: var(--text); }

  .prev-next {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .prev-next-link {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    max-width: 45%;
  }
  .prev-next-link.next { text-align: right; margin-left: auto; }
  .nav-dir {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--text-faint);
  }
  .nav-title { color: var(--text-dim); }
  .prev-next-link:hover .nav-title { color: var(--accent); }
</style>
